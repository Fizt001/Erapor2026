# Normalkan semua file teks ke LF (berlaku untuk erapor-fe)
* text=auto eol=lf

# Source code Vue/Nuxt eksplisit LF
*.vue      text eol=lf
*.ts       text eol=lf
*.js       text eol=lf
*.mjs      text eol=lf
*.cjs      text eol=lf
*.css      text eol=lf
*.html     text eol=lf
*.json     text eol=lf
*.yaml     text eol=lf
*.yml      text eol=lf
*.md       text eol=lf
*.env      text eol=lf
*.example  text eol=lf

# File biner
*.png      binary
*.jpg      binary
*.jpeg     binary
*.gif      binary
*.svg      binary
*.ico      binary
*.woff     binary
*.woff2    binary
*.ttf      binary
*.eot      binary
*.otf      binary
